{
  "name": "dsh-douyin-comments",
  "version": "0.9.40",
  "description": "DeepSeek Harness / NovaFlow plugin: collect Douyin video comments with a bundled Chrome extension (douyin_comments tool) + the merged comment wordcloud viewer (interactive wordcloud + comment table + AI digest + region filter + favorite customers (also listed / searchable / exportable on the collector page) + shop-accounts account reuse (Chrome/ego) + AES-encrypted collector + unified UI (shared design tokens, dark/light, manual theme switch, compact region distribution, terse one-line copy with details moved to tooltips)) that opens automatically after a collection",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./collector": "./collector.mjs",
    "./console": "./console.mjs",
    "./viewer": "./viewer.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "shop-accounts-bridge.mjs",
    "collector.mjs",
    "core.enc",
    "extension.enc",
    "console.mjs",
    "viewer.mjs",
    "entitlement.mjs",
    "scripts-library.mjs",
    "outreach.mjs",
    "app",
    "viewer",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "sync-ext": "node sync-extension.mjs",
    "build-encrypted": "node build-encrypted.mjs",
    "verify": "node verify-tool.mjs",
    "verify-console": "node verify-console.mjs",
    "verify-encrypted": "node verify-encrypted.mjs",
    "verify-merged": "node verify-merged.mjs",
    "verify-client": "node verify-client.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
